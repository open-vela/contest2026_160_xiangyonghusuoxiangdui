+ ****************************************************************************/
+
+/* Deliberately empty of mounts.
+ *
+ * The reference boards mount procfs here. This one already has it: bringup does
+ * it in evb7_amp_bringup(), before nsh exists, because the board's own init
+ * wants /proc regardless of whether a shell ever runs. Mounting it a second time
+ * from here would fail with EBUSY and print an error on the console at every
+ * boot, which is a worse outcome than an empty script.
+ *
+ * The file exists because nsh looks for CONFIG_NSH_SYSINITSCRIPT before
+ * CONFIG_NSH_INITSCRIPT and both are wanted in the image; leaving it out means
+ * the shell reports a missing script on the way to running the one that is
+ * there.
+ */
+
+#include <nuttx/config.h>
