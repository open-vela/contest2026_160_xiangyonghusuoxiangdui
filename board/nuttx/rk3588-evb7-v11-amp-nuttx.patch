--- /dev/null
+++ b/boards/arm64/rk3588/evb7-amp/src/evb7_amp_fb.c
@@ -0,0 +1,750 @@
+/****************************************************************************
+ * boards/arm64/rk3588/evb7-amp/src/evb7_amp_fb.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
