+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+# License for the specific language governing permissions and limitations
+# under the License.
+#
+############################################################################
+
+include $(TOPDIR)/Make.defs
+
+CSRCS = evb7_amp_boardinit.c evb7_amp_bringup.c
+
+ifeq ($(CONFIG_RPTUN),y)
+CSRCS += evb7_amp_shm.c evb7_amp_cam.c
+endif
+
+# The framebuffer sits on top of the shared area, so it needs both the fb
+# framework and the tunnel that carries the frame notifications.
+
+ifeq ($(CONFIG_RPTUN),y)
+ifeq ($(CONFIG_VIDEO_FB),y)
+CSRCS += evb7_amp_fb.c
+# Driving the VOP's Esmart3 window directly, instead of asking Linux to blit.
+CSRCS += evb7_amp_vop.c
+endif
+
+# Touch events arrive over the same rpmsg endpoint as the frame signalling.
+
+ifeq ($(CONFIG_INPUT_TOUCHSCREEN),y)
+CSRCS += evb7_amp_touch.c
+endif
+endif
+
+ifeq ($(CONFIG_BOARDCTL),y)
+CSRCS += evb7_amp_appinit.c
+ifeq ($(CONFIG_BOARDCTL_RESET),y)
+CSRCS += evb7_amp_reset.c
+endif
+endif
+
+# Startup scripts, built into a ROMFS image mounted at /etc by nx_bringup()
+# before the init task runs. This is how the UI is started at boot: nsh executes
+# rc.sysinit and then rcS, and rcS launches it in the background.
+#
+# Both files are listed because nsh looks for both, and both are run through the
+# C preprocessor on the way in - which is what lets rcS guard the launch on the
+# application actually being configured.
+ifeq ($(CONFIG_ETC_ROMFS),y)
+RCSRCS = etc/init.d/rc.sysinit etc/init.d/rcS
+endif
+
+include $(TOPDIR)/boards/Board.mk
