+
+/* Run once, by nsh, before it takes the console.
+ *
+ * This file is preprocessed on the way into the ROMFS image, so the guard below
+ * is a real one: turning EXAMPLES_AMPUI off removes the line rather than leaving
+ * a command that fails at every boot.
+ *
+ * Started in the background, so nsh continues to the prompt. The shell is on
+ * /dev/ttyproxy over rpmsg and is the only way into this core, so it must not be
+ * blocked by the UI - and the UI must not be the thing that has to be killed to
+ * get a shell back.
+ *
+ * ampui and ampcam cannot both run: ampui renders through LVGL into /dev/fb0's
+ * buffers while ampcam writes the first of them directly, with no ownership
+ * protocol between the two. ampcam is still built, for the transport counters it
+ * prints, so stopping ampui first is on whoever wants it.
+ */
+
+#include <nuttx/config.h>
+
+#ifdef CONFIG_EXAMPLES_AMPUI
+ampui &
+#endif
